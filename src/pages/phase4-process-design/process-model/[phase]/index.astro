---
// 統合プロセス参照モデル 第2階層(ADR-0020)
import { getEntry } from 'astro:content';
import ProcessPhase from '../../../../components/process/ProcessPhase.astro';
import { PROCESS_MODEL_ID } from '../../../../lib/process-diagrams';

export async function getStaticPaths() {
  const entry = await getEntry('processes', PROCESS_MODEL_ID);
  if (!entry) throw new Error(`processes コレクションに ${PROCESS_MODEL_ID} が存在しません`);
  return entry.data.phases.map((phase) => ({
    params: { phase: phase.id },
    props: { entry, phase },
  }));
}

const { entry, phase } = Astro.props;
---

<ProcessPhase entry={entry} phase={phase} />
