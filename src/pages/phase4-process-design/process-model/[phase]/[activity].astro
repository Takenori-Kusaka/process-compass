---
// ピットイン方式参照モデル 第3階層(ADR-0020)
import { getEntry } from 'astro:content';
import ProcessActivity from '../../../../components/process/ProcessActivity.astro';
import { PROCESS_MODEL_ID } from '../../../../lib/process-diagrams';

export async function getStaticPaths() {
  const entry = await getEntry('processes', PROCESS_MODEL_ID);
  if (!entry) throw new Error(`processes コレクションに ${PROCESS_MODEL_ID} が存在しません`);
  return entry.data.phases.flatMap((phase) =>
    phase.activities.map((activity) => ({
      params: { phase: phase.id, activity: activity.id },
      props: { entry, phase, activity },
    }))
  );
}

const { entry, phase, activity } = Astro.props;
---

<ProcessActivity entry={entry} phase={phase} activity={activity} />
