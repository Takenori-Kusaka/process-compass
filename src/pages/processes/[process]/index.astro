---
// 既存プロセスのカタログ 第1階層。統合プロセス参照モデルは本標準の一部であり
// /phase4-process-design/process-model/ 側で生成する(ADR-0020)
import { getCollection } from 'astro:content';
import ProcessOverview from '../../../components/process/ProcessOverview.astro';
import { PROCESS_MODEL_ID } from '../../../lib/process-diagrams';

export async function getStaticPaths() {
  const processes = await getCollection('processes');
  return processes
    .filter((entry) => entry.id !== PROCESS_MODEL_ID)
    .map((entry) => ({ params: { process: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
---

<ProcessOverview entry={entry} />
