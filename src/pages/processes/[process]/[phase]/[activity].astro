---
// 既存プロセスのカタログ 第3階層(ADR-0020: ピットイン方式参照モデルは除外)
import { getCollection } from 'astro:content';
import ProcessActivity from '../../../../components/process/ProcessActivity.astro';
import { PROCESS_MODEL_ID } from '../../../../lib/process-diagrams';

export async function getStaticPaths() {
  const processes = await getCollection('processes');
  return processes
    .filter((entry) => entry.id !== PROCESS_MODEL_ID)
    .flatMap((entry) =>
      entry.data.phases.flatMap((phase) =>
        phase.activities.map((activity) => ({
          params: { process: entry.id, phase: phase.id, activity: activity.id },
          props: { entry, phase, activity },
        }))
      )
    );
}

const { entry, phase, activity } = Astro.props;
---

<ProcessActivity entry={entry} phase={phase} activity={activity} />
