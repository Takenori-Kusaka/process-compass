---
// 既存プロセスのカタログ 第2階層(ADR-0020: 統合プロセス参照モデルは除外)
import { getCollection } from 'astro:content';
import ProcessPhase from '../../../../components/process/ProcessPhase.astro';
import { PROCESS_MODEL_ID } from '../../../../lib/process-diagrams';

export async function getStaticPaths() {
  const processes = await getCollection('processes');
  return processes
    .filter((entry) => entry.id !== PROCESS_MODEL_ID)
    .flatMap((entry) =>
      entry.data.phases.map((phase) => ({
        params: { process: entry.id, phase: phase.id },
        props: { entry, phase },
      }))
    );
}

const { entry, phase } = Astro.props;
---

<ProcessPhase entry={entry} phase={phase} />
