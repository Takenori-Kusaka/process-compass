{
  "name": "process-compass",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "lint:text": "textlint \"src/content/docs/**/*.md\" \"src/content/docs/**/*.mdx\" README.md",
    "lint:tone": "node scripts/check-tone.mjs",
    "lint:evidence": "node scripts/check-evidence.mjs",
    "evidence:write": "node scripts/check-evidence.mjs --write",
    "lint:impl": "node scripts/check-impl.mjs",
    "impl:write": "node scripts/check-impl.mjs --write",
    "test:engine": "node scripts/test-tailoring-engine.mjs",
    "check": "npm run lint:text && npm run lint:tone && npm run lint:evidence && npm run lint:impl && npm run test:engine && npm run test:template && npm run build",
    "template:kb": "node scripts/build-template-kb.mjs",
    "test:template": "node scripts/check-template-drift.mjs"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.3",
    "@astrojs/starlight": "^0.41.6",
    "astro": "^7.2.0",
    "astro-mermaid": "^2.1.0",
    "mermaid": "^11.16.1",
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "starlight-links-validator": "^0.25.2",
    "textlint": "^15.8.0",
    "textlint-rule-preset-ja-technical-writing": "^12.0.2",
    "yaml": "^2.9.0"
  }
}
