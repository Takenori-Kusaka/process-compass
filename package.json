{
  "name": "process-compass",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "lint:text": "textlint \"src/content/docs/**/*.md\" \"src/content/docs/**/*.mdx\" README.md",
    "lint:tone": "node scripts/check-tone.mjs",
    "lint:evidence": "node scripts/check-evidence.mjs",
    "evidence:write": "node scripts/check-evidence.mjs --write",
    "lint:impl": "node scripts/check-impl.mjs",
    "impl:write": "node scripts/check-impl.mjs --write",
    "lint:scope": "node scripts/check-scope.mjs",
    "scope:write": "node scripts/check-scope.mjs --write",
    "lint:refs": "node scripts/check-section-refs.mjs",
    "lint:provisions": "node scripts/check-provisions.mjs",
    "lint:skills": "node scripts/check-skill-provisions.mjs",
    "lint:ci": "node scripts/check-ci-wiring.mjs",
    "test:engine": "node scripts/test-tailoring-engine.mjs",
    "test:impl": "node scripts/test-check-impl.mjs",
    "test:ci-wiring": "node scripts/test-check-ci-wiring.mjs",
    "lint:sources": "node scripts/research-ledger.mjs lint",
    "sources:index": "node scripts/research-ledger.mjs index",
    "check": "npm run lint:ci && npm run lint:text && npm run lint:tone && npm run lint:evidence && npm run lint:impl && npm run lint:scope && npm run lint:refs && npm run lint:provisions && npm run lint:skills && npm run lint:figures && npm run brand:check && npm run lint:sources && npm run lint:registry && npm run test:engine && npm run test:impl && npm run test:ci-wiring && npm run test:template && npm run test:fields && npm run test:criteria && npm run build",
    "lint:registry": "node scripts/check-recalibration-registry.mjs",
    "template:kb": "node scripts/build-template-kb.mjs",
    "test:template": "node scripts/check-template-drift.mjs",
    "test:fields": "node scripts/check-template-fields.mjs",
    "test:criteria": "node scripts/check-gate-criteria.mjs",
    "criteria:write": "node scripts/check-gate-criteria.mjs --write",
    "lint:figures": "node scripts/check-figures-svg.mjs",
    "brand:sync": "node scripts/brand-sync.mjs",
    "brand:check": "node scripts/brand-sync.mjs --check"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.3",
    "@astrojs/starlight": "^0.41.6",
    "astro": "^7.2.0",
    "astro-mermaid": "^2.1.0",
    "mermaid": "^11.16.1",
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "starlight-links-validator": "^0.25.2",
    "textlint": "^15.8.0",
    "textlint-rule-preset-ja-technical-writing": "^12.0.2",
    "yaml": "^2.9.0"
  }
}
